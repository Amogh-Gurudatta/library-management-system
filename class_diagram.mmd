---
title: Library Management System - Class Diagram
---
classDiagram
    direction TB

    class Borrowable {
        <<interface>>
        +getFinePerDay() int
    }

    class LibraryItem {
        <<abstract>>
        -String id
        -String title
        +getId() String
        +getTitle() String
        +getTypeName()* String
        +matchesTitle(String text) boolean
    }

    class Book {
        -String author
        +getAuthor() String
        +getTypeName() String
        +getFinePerDay() int
    }

    class Magazine {
        -String issue
        +getIssue() String
        +getTypeName() String
        +getFinePerDay() int
    }

    class ReferenceBook {
        -String author
        +getAuthor() String
        +getTypeName() String
    }

    class Member {
        <<abstract>>
        -String id
        -String name
        +getId() String
        +getName() String
        +getMaxItems()* int
        +getLoanPeriod()* int
    }

    class Student {
        +getMaxItems() int
        +getLoanPeriod() int
    }

    class Staff {
        +getMaxItems() int
        +getLoanPeriod() int
    }

    class Faculty {
        +getMaxItems() int
        +getLoanPeriod() int
    }

    class Loan {
        -LibraryItem item
        -Member member
        -int borrowDay
        -int dueDay
        +getItem() LibraryItem
        +getMember() Member
        +getDueDay() int
        +daysLate(int today) int
        +fine(int today) int
    }

    class Library {
        -Map~String, LibraryItem~ items
        -Map~String, Member~ members
        -Map~String, Loan~ loans
        -int today
        +addItem(LibraryItem item)
        +addMember(Member member)
        +borrow(String memberId, String itemId) Loan
        +returnItem(String itemId) int
        +advance(int days) int
        +search(String text) List~LibraryItem~
        +loansOf(String memberId) List~Loan~
        +overdueLoans() List~Loan~
        +inventory() List~LibraryItem~
        +getToday() int
    }

    class CommandProcessor {
        -Library library
        +run(Scanner in)
        -execute(String line) String
        -requireFields(String[] parts, int count)
        -parseInt(String text, String field) int
        -parseMemberType(String text) Member
    }

    class Main {
        +main(String[] args)$
    }

    class LibraryException {
        <<abstract>>
    }
    class ItemNotFoundException
    class MemberNotFoundException
    class ItemNotAvailableException
    class BorrowLimitExceededException
    class ItemNotOnLoanException
    class InvalidInputException
    class DuplicateIdException
    class ReservationNotAllowedException

    %% Inheritance and realisation
    LibraryItem <|-- Book
    LibraryItem <|-- Magazine
    LibraryItem <|-- ReferenceBook
    Borrowable <|.. Book
    Borrowable <|.. Magazine

    Member <|-- Student
    Member <|-- Staff
    Member <|-- Faculty

    LibraryException <|-- ItemNotFoundException
    LibraryException <|-- MemberNotFoundException
    LibraryException <|-- ItemNotAvailableException
    LibraryException <|-- BorrowLimitExceededException
    LibraryException <|-- ItemNotOnLoanException
    LibraryException <|-- ReservationNotAllowedException
    LibraryException <|-- InvalidInputException
    LibraryException <|-- DuplicateIdException

    %% Associations
    Main --> CommandProcessor : creates
    CommandProcessor --> Library : drives
    Library "1" o-- "*" LibraryItem : catalogue
    Library "1" o-- "*" Member : members
    Library "1" *-- "*" Loan : active loans
    Loan "*" --> "1" LibraryItem : of
    Loan "*" --> "1" Member : held by

    %% Dependencies
    Library ..> Borrowable : checks instanceof
    Library ..> LibraryException : throws
    CommandProcessor ..> LibraryException : catches once

    %% Colour key:
    %% blue = item hierarchy, purple = Borrowable interface, green = member hierarchy,
    %% amber = core logic (Main, CommandProcessor, Library, Loan),
    %% red = rule exceptions, pink = validation exceptions, grey = bonus
    style LibraryItem fill:#dbeafe,stroke:#2563eb,color:#111
    style Book fill:#dbeafe,stroke:#2563eb,color:#111
    style Magazine fill:#dbeafe,stroke:#2563eb,color:#111
    style ReferenceBook fill:#dbeafe,stroke:#2563eb,color:#111
    style Borrowable fill:#ede9fe,stroke:#7c3aed,color:#111
    style Member fill:#dcfce7,stroke:#16a34a,color:#111
    style Student fill:#dcfce7,stroke:#16a34a,color:#111
    style Staff fill:#dcfce7,stroke:#16a34a,color:#111
    style Faculty fill:#dcfce7,stroke:#16a34a,color:#111
    style Main fill:#fef3c7,stroke:#d97706,color:#111
    style CommandProcessor fill:#fef3c7,stroke:#d97706,color:#111
    style Library fill:#fef3c7,stroke:#d97706,color:#111
    style Loan fill:#fef3c7,stroke:#d97706,color:#111
